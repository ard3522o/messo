# Copy to .env and replace both values with distinct random secrets (32+ chars).
JWT_SECRET=replace-with-a-long-random-secret
QR_SECRET=replace-with-a-different-long-random-secret

# Set these to the public site origin and desired local/VPS port.
CLIENT_URL=http://localhost:8080
WEB_PORT=8080

# Optional payment provider configuration
PAYMENT_GATEWAY_ENABLED=false
PAYMENT_GATEWAY_KEY=
MONTHLY_MESS_FEE=3500
