# Runtime
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# Database
# Production: point this at your MongoDB deployment and set USE_MEMORY_DB=false.
MONGODB_URI=mongodb://127.0.0.1:27017/messmgmt
USE_MEMORY_DB=false
MEMORY_DB_PATH=./.data/db

# Auth
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d
QR_SECRET=replace-with-a-separate-random-string

# Payments (optional gateway integration)
PAYMENT_GATEWAY_ENABLED=false
PAYMENT_GATEWAY_KEY=
MONTHLY_MESS_FEE=3500
